#include <iostream>
#include <algorithm>
using namespace std;

long long sumRange(int a, int b) {
    if (a > b) swap(a, b);
    long long sum = 0;
    for (int i = a; i <= b; i++) {
        sum += i;
    }
    return sum;
}

int main() {
    int a, b;
    cin >> a >> b;
    cout << sumRange(a, b) << endl;
    return 0;
}
